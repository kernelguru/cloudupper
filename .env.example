# Passwort für die Weboberfläche (unbedingt setzen!)
APP_PASSWORD=bitte-aendern

# Öffentliche Adresse der App (für OAuth-Weiterleitung), z.B. https://cloud.meinedomain.de
BASE_URL=

# TorBox API-Key (alternativ in der App unter Clouds → Einstellungen)
TORBOX_API_KEY=

# Gleichzeitige Übertragungen
MAX_PARALLEL=2

# Zusätzliche rclone-Optionen, z.B. Bandbreitenlimit oder Chunkgrößen
# RCLONE_FLAGS=--bwlimit 20M --drive-chunk-size 64M --onedrive-chunk-size 50M
RCLONE_FLAGS=

# Push-Benachrichtigung bei fertigen/fehlgeschlagenen Aufträgen (ntfy.sh-kompatibel)
# NOTIFY_URL=https://ntfy.sh/mein-geheimes-topic
NOTIFY_URL=

# Optionale eigene OAuth-Apps für "Mit … anmelden"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
HIDRIVE_CLIENT_ID=
HIDRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Zeitzone (Fallback für Zeitpläne)
TZ=Europe/Berlin

# Optionales WireGuard-VPN (z.B. Proton VPN) für den gesamten Verkehr
# Konfiguration nach ./config/wireguard/wg0.conf legen, cap_add NET_ADMIN ist in docker-compose.yml gesetzt
VPN_ENABLED=false
VPN_KILLSWITCH=true
# Netze, die am VPN vorbei erreichbar bleiben (Weboberfläche)
LAN_NETWORK=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8
